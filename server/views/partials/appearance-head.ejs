<script>
  window.DOCNEST_CONFIG = {
    authEnabled: <%= docsAuthEnabled ? 'true' : 'false' %>,
    authStorageKey: <%- JSON.stringify(docsAuthStorageKey) %>,
    siteTitle: <%- JSON.stringify(docsTitle) %>,
    restrictedMode: <%= docsRestrictedMode ? 'true' : 'false' %>,
    storageKeyPrefix: <%- JSON.stringify(docsStorageKeyPrefix) %>,
    appearance: {
      defaultTheme: <%- JSON.stringify(docsThemeDefault) %>,
      defaultMode: <%- JSON.stringify(docsThemeModeDefault) %>,
      enabledThemes: <%- JSON.stringify(docsThemeEnabled) %>
    }
  };
  if (window.DOCNEST_CONFIG.authEnabled) {
    document.documentElement.classList.add('docnest-auth-pending');
  }
</script>
