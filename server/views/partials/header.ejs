<header class="header">
  <div class="header-content">
    <div class="header-title-group">
      <h1>
        <% if (docsLogo) { %><img class="brand-logo" src="<%= docsLogo %>" alt=""><% } else { %><span class="brand-fallback" aria-hidden="true"><span class="brand-fallback-emoji">📚</span><span class="brand-fallback-shape"></span></span><% } %>
        <%= docsTitle %>
      </h1>
      <% if (typeof showBackLink !== 'undefined' && showBackLink) { %>
        <a href="/" class="back-link">← 返回目录</a>
      <% } else { %>
        <p class="subtitle"><%= docsSubtitle %></p>
      <% } %>
    </div>
    <div class="header-meta">
      <div class="header-actions">
        <% if (typeof showPrintButton !== 'undefined' && showPrintButton) { %>
          <button type="button" id="print-doc-btn" class="header-action-btn print-btn" title="打印当前文章">
            <span class="print-icon">🖨️</span>
            <span class="header-action-text">打印</span>
          </button>
        <% } %>
        <% if (typeof showPdfButton !== 'undefined' && showPdfButton) { %>
          <button type="button" id="download-doc-pdf-btn" class="header-action-btn download-pdf-btn" title="下载当前文章 PDF">
            <span class="download-pdf-icon">⬇️</span>
            <span class="header-action-text">下载 PDF</span>
          </button>
        <% } %>
        <div class="theme-selector" id="theme-selector">
          <button
            id="theme-style-toggle"
            class="header-action-btn theme-style-toggle"
            type="button"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="theme-popover"
            title="选择文档中心主题"
          >
            <span class="theme-swatch" aria-hidden="true"></span>
            <span class="theme-style-text">Slate Modern</span>
            <span class="theme-chevron" aria-hidden="true">⌄</span>
          </button>
          <div class="theme-popover" id="theme-popover" role="dialog" aria-label="外观设置" hidden>
            <div class="theme-popover-section">
              <p class="theme-popover-label">主题风格</p>
              <div class="theme-options" id="theme-options" role="radiogroup" aria-label="主题风格"></div>
            </div>
            <div class="theme-popover-section theme-mode-section">
              <p class="theme-popover-label">明暗模式</p>
              <div class="theme-mode-options" id="theme-mode-options" role="radiogroup" aria-label="明暗模式"></div>
            </div>
          </div>
        </div>
        <button id="theme-toggle" class="header-action-btn theme-toggle" type="button" title="切换明暗模式">
          <span class="theme-icon" aria-hidden="true">A</span>
          <span class="theme-text">跟随系统</span>
        </button>
      </div>
    </div>
  </div>
</header>
