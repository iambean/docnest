<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= docsTitle %></title>
  <link rel="icon" href="/favicon.ico?v=<%= assetVersion %>" sizes="any">
  <link id="markdown-theme" rel="stylesheet" href="/vendor/github-markdown-css/github-markdown-light.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/static/css/styles.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/static/css/highlight.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/static/css/themes.css?v=<%= assetVersion %>">
  <script src="/mermaid/mermaid.min.js?v=<%= assetVersion %>"></script>
  <%- include('partials/appearance-head') %>
  <!-- 基础功能模块 -->
  <script src="/static/js/core/theme.js?v=<%= assetVersion %>"></script>
  <script src="/static/js/core/mermaid-init.js?v=<%= assetVersion %>"></script>
  <script src="/static/js/core/sidebar.js?v=<%= assetVersion %>"></script>
</head>
<body>
  <%- include('partials/page-protection') %>
  <div class="container">
    <%- include('partials/header', { showBackLink: false }) %>
    <div class="content">
      <%- include('partials/sidebar') %>
      <main class="main-content">
        <div class="welcome">
          <h2>欢迎使用文档中心</h2>
          <p>请从左侧目录选择要查看的文档。</p>
        </div>
      </main>
    </div>
  </div>
  <% if (!docsRestrictedMode) { %>
    <%- include('partials/diagram-viewer') %>
    <!-- 按依赖顺序加载模块 -->
    <script src="/static/js/utils/modal-stack.js?v=<%= assetVersion %>"></script>
    <script src="/static/js/diagram/diagram-viewer.js?v=<%= assetVersion %>"></script>
    <script src="/static/js/diagram/diagram-zoom.js?v=<%= assetVersion %>"></script>
    <script src="/static/js/diagram/diagram-drag.js?v=<%= assetVersion %>"></script>
    <script src="/static/js/diagram/diagram-controls.js?v=<%= assetVersion %>"></script>
    <script src="/static/js/diagram/diagram-download.js?v=<%= assetVersion %>"></script>
  <% } %>
  <script src="/static/js/utils/app.js?v=<%= assetVersion %>"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    // 实时更新功能
    (function() {
      const socket = io();
      
      socket.on('file-changed', function(data) {
        console.log('文件已更新:', data.path);
        // 刷新整个页面以更新目录树
        location.reload();
      });
      
      socket.on('file-added', function(data) {
        console.log('新文件已添加:', data.path);
        location.reload();
      });
      
      socket.on('file-deleted', function(data) {
        console.log('文件已删除:', data.path);
        location.reload();
      });
      
      socket.on('connect', function() {
        console.log('✅ 已连接到服务器，实时更新已启用');
      });
      
      socket.on('disconnect', function() {
        console.log('❌ 与服务器断开连接');
      });
    })();
  </script>
</body>
</html>
